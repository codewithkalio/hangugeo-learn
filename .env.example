# Supabase (required)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# hCaptcha (optional). When set, Magic Link and Demo sign-in require solving the captcha.
# Get the site key from https://www.hcaptcha.com/ (same site whose secret is in Supabase Auth > Bot and Abuse Protection).
# Leave unset for local dev without captcha. For local testing with captcha, see hCaptcha docs (e.g. ngrok).
VITE_HCAPTCHA_SITE_KEY=

# PostHog (optional). When set, analytics and session recording are enabled.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Production hostname (optional). When set and equal to the app hostname, auth uses production flow (magic link only). Leave unset for local dev (email/password). Example: hangugeo-learn.lovable.app
VITE_PRODUCTION_HOSTNAME=
